{
  "name": "qazsplit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm --workspace app run build",
    "lint": "npm --workspace app run lint",
    "test": "npm --workspace app run test",
    "test:anchor": "mocha --import=tsx --timeout 100000 tests/qazsplit.ts tests/agreement.ts",
    "verify:fixture": "node scripts/verify-devnet-fixture.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "check:program": "anchor build && anchor test"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "chai": "6.2.0",
    "mocha": "11.7.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}

