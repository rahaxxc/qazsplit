# Copy to app/.env.local for local development. Never commit real values.
# Everything here is read only by server-side route handlers. Do NOT add a NEXT_PUBLIC_ prefix:
# NEXT_PUBLIC_* values are inlined into the browser bundle.

# Required only for the optional MultiHopper onward routing (devnet SOL). Without it, QazSplit
# agreements, approvals and milestone payments work exactly as before; routing reports that it
# is not configured. Create a devnet key (mh_test_...) at
# https://devnet.multihopper.com/developer/dashboard — mainnet mh_live_ keys are refused.
MULTIHOPPER_API_KEY=

# Optional. Dedicated secret (32+ characters) for QazSplit's per-transfer routing access tokens.
# When unset, a separate key is derived from MULTIHOPPER_API_KEY with HKDF.
# Generate one with: openssl rand -base64 32
QAZSPLIT_ROUTING_SECRET=

# Optional, not secret. The public origin routing approvals must be signed on, e.g.
# https://qazsplit.example. Leave unset when the request host is already the public one.
QAZSPLIT_PUBLIC_ORIGIN=

# Optional public settings, unchanged (see docs/development.md).
# NEXT_PUBLIC_SOLANA_RPC_URL=
# NEXT_PUBLIC_QAZSPLIT_PROGRAM_ID=
